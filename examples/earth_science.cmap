title "The water cycle"
layout radial root=water
page a3
font 8pt..34pt wrap=16em
theme light root=#0D47A1 link=#546E7A

style reservoir color=#1565C0
style process color=#2E7D32
style atmosphere color=#6A1B9A
style impact color=#C62828

node water "Water" .reservoir
| solid, liquid, and vapor
| mass is conserved as state changes
node ocean "Ocean" .reservoir
| largest active reservoir
| stores heat and dissolved salts
node ice "Ice and snow" .reservoir
| glaciers, ice caps, and seasonal snow
| high albedo reflects solar radiation
node ground "Groundwater" .reservoir
| water stored in pores and fractures
| residence time can be centuries
node atmosphere "Atmospheric vapor" .atmosphere
| small reservoir with rapid turnover
| transports water between regions
node evaporation "Evaporation" .process
| liquid -> vapor using solar energy
| latent heat leaves the surface
node condensation "Condensation" .atmosphere
| vapor -> cloud droplets
| requires cooling or saturation
node precipitation "Precipitation" .atmosphere
| rain, snow, sleet, or hail
| gravity returns water to the surface
node runoff "Runoff" .process
| water flows over land to rivers
| depends on slope, soil, and vegetation
node infiltration "Infiltration" .process
| water enters soil and aquifers
| permeability controls the rate
node transpiration "Transpiration" .process
| plants release water vapor
| stomata couple carbon and water exchange
node storage "Surface storage" .reservoir
| lakes, wetlands, and soil moisture
| buffers floods and droughts
node human "Human withdrawals" .impact
| irrigation and pumping move water
| use can exceed natural recharge
node balance "Water balance" .process
| input - output = change in storage
| basin budgets expose unsustainable use
node climate "Climate feedback" .impact fill=#FFEBEE
| warming changes vapor capacity and ice melt
| circulation shifts precipitation patterns

water -> ocean
water -> ice
water -> ground
water -> atmosphere
ocean -> evaporation
ice -> evaporation
ground -> infiltration
atmosphere -> condensation
evaporation -> condensation
transpiration -> condensation
condensation -> precipitation
precipitation -> runoff
precipitation -> infiltration
runoff -> ocean
infiltration -> ground
runoff -> storage
storage -> evaporation
human ..> ground "pumping" .impact
human ..> storage "withdrawal" .impact
climate ..> evaporation "warming" .impact
climate ..> ice "melting" .impact
ocean ..> balance "reservoir"
ground ..> balance "reservoir"

require water at center
prefer condensation at top weight=2
prefer precipitation at bottom weight=2
prefer balance near human within=18em weight=2
