# Test the radial layout strategy.
title "Radial Layout Test"
layout radial
page a4

node center "Central Hub"
node n1 "North"
node n2 "North-East"
node n3 "East"
node n4 "South-East"
node n5 "South"
node n6 "South-West"
node n7 "West"
node n8 "North-West"

center -> n1
center -> n2
center -> n3
center -> n4
center -> n5
center -> n6
center -> n7
center -> n8

# Force some specific positions to see if radial handles it
require n1 at top
require n5 at bottom
prefer n3 at right weight=5
prefer n7 at left weight=5
