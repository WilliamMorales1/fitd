// UML sequence diagram (Reggio et al., Nickerson: second UML type). Lanes keep message order.
include "seq"
layout lanes order=source
page 4:3
seq.actor
  user User
  app App
  api API
  db Database
seq.msg
  m1 user app "log in"
  m2 app api "POST /session"
  m3 api db "find user"
seq.reply
  m4 db api row
  m5 api app token
  m6 app user "home page"
