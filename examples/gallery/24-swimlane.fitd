// Swimlane activity diagram (Reggio et al.). Each group is a lane, in declaration order.
include "flow"
layout lanes
page 4:3

with flow.io {
  order "Place order"
}
with flow.step {
  pay "Take payment"
  ship "Pack and ship"
  refund "Refund"
  receipt "Send receipt"
}
with flow.decide {
  stock "In stock?"
}
with flow.done {
  done "Receive parcel"
}
order -> pay -> stock -> ship "yes"
stock -> refund "no"
ship -> receipt -> done
group "Customer" order, done
group "Shop" pay, stock, refund, receipt
group "Warehouse" ship
