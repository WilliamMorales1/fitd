# Swimlane activity diagram (Reggio et al.). Each group is a lane, in declaration order.
include "flow"
layout lanes
page 4:3
io
  order "Place order"
end
step
  pay "Take payment"
end
decide
  stock "In stock?"
end
step
  ship "Pack and ship"
  refund "Refund"
  receipt "Send receipt"
end
done
  done "Receive parcel"
end
order -> pay
pay -> stock
stock -> ship "yes"
stock -> refund "no"
ship -> receipt
receipt -> done
group "Customer" order, done
group "Shop" pay, stock, refund, receipt
group "Warehouse" ship
