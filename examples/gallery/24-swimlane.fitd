# Swimlane activity diagram (Reggio et al.). Each group is a lane, in declaration order.
include "flow"
layout lanes
page 4:3
io
  order "Place order"
step
  pay "Take payment"
decide
  stock "In stock?"
step
  ship "Pack and ship"
  refund "Refund"
  receipt "Send receipt"
done
  done "Receive parcel"
order -> pay
pay -> stock
stock -> ship "yes"
stock -> refund "no"
ship -> receipt
receipt -> done
group "Customer" order, done
group "Shop" pay, stock, refund, receipt
group "Warehouse" ship
