# Architecture / block diagram (Nickerson: 212 of 983, the largest genre; DocFigure block diagram).
include "arch"
layout layered dir=right
page 16:9
font 9pt..28pt
arch.client("web", "Web app")
arch.service("api", "API")
arch.service("work", "Worker")
arch.queue("q", "Jobs")
arch.store("db", "Postgres")
arch.ext("pay", "Stripe")
web -> api -> q -> work
api -> db
work -> db
work -> pay
arch_zone
  group "Cloud" api, q, work, db
end
arch.key()
