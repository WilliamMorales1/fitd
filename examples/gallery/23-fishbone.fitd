# Cause-and-effect (Ishikawa) diagram (quality management), drawn as a tree into the effect.
layout layered dir=right order=source
page 16:9
font 9pt..28pt
style cause shape=none
node effect "Late release"
node people "People"
node process "Process"
node tools "Tools"
node p1 "on leave" .cause
node p2 "no reviews" .cause
node t1 "flaky CI" .cause
p1 -> people
p2 -> process
t1 -> tools
people -> effect
process -> effect
tools -> effect
