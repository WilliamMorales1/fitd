// Data-flow diagram (Nickerson: flow, 80 of 983).
include "arch"
layout layered [dir=right]
page 3:1

arch.ext(sensor, Sensors)
arch.service(clean, Clean)
arch.service(feat, Featurize)
arch.service(train, Train)
arch.store(lake, "Data lake")
arch.client(dash, Dashboard)
sensor -> clean "raw" -> lake -> feat -> train -> dash "metrics"
