// Algorithm block (DocFigure and ACL-Fig: "algorithm" class).
include "algo"
layout layered
page 4:3

algo.block(dijkstra, "Algorithm 1: Dijkstra(G, s)") {
  algo.for("v in V") {
    | d[v] = inf
    | prev[v] = none
  }
  | d[s] = 0
  | Q = V
  algo.while("Q not empty") {
    | u = argmin d[u] in Q
    | remove u from Q
    algo.for("v in adj(u)") {
      algo.if("d[u] + w(u, v) < d[v]") {
        | d[v] = d[u] + w(u, v)
        | prev[v] = u
      }
    }
  }
  algo.return("d, prev")
}
