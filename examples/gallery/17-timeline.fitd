# Timeline (history, project reports).
include "time"
layout layered dir=right
page 16:9
font 9pt..28pt
time.event("t1", "1957", "Sputnik")
time.mile("t2", "1969", "Moon landing")
time.event("t3", "1990", "Hubble")
time.event("t4", "1998", "ISS")
time.mile("t5", "2021", "JWST")
time.chain("t1; t2; t3; t4; t5")
