# Flowchart (DocFigure, Nickerson: tight genre). std/flow gives the role colours.
include "std/flow.fitd"
layout layered
page 3:4
font 9pt..28pt
node req "Request" .io
node auth "Signed in?" .decide
node login "Log in" .step
node serve "Serve page" .done
req -> auth
auth -> serve "yes"
auth -> login "no"
login -> serve
use flow_key()
