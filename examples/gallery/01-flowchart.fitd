// Flowchart (DocFigure, Nickerson: tight genre). std/flow gives the role colours.
include "flow"
layout layered
page 3:4
flow.io
  req "Request"
flow.decide
  auth "Signed in?"
flow.step
  login "Log in"
flow.done
  serve "Serve page"
req -> auth -> serve "yes"
auth -> login "no" -> serve
flow.key
