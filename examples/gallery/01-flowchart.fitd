// Flowchart (DocFigure, Nickerson: tight genre). std/flow gives the role colours.
include "flow"
layout layered
page 3:4

with flow.io {
  req "Request"
}
with flow.decide {
  auth "Signed in?"
}
with flow.step {
  login "Log in"
}
with flow.done {
  serve "Serve page"
}
req -> auth -> serve "yes"
auth -> login "no" -> serve
flow.key()
