# UML state machine (Reggio et al.: state machine among the core UML diagrams).
include "uml"
layout layered dir=right
page 3:1
font 9pt..28pt
uml.start("s0")
uml.state("idle", "Idle", "")
uml.state("run", "Running", "do: tick")
uml.state("done", "Done", "")
uml.final("s1")
s0 -> idle
idle -> run "start"
run -> done "finish"
done -> s1
run ..> idle "pause"
