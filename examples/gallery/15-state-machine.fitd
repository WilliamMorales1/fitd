# UML state machine (Reggio et al.: state machine among the core UML diagrams).
include "uml"
layout layered dir=right
page 16:9
font 9pt..28pt
uml.start s0
uml.state
  idle Idle ""
  run Running "do: tick"
  done Done ""
uml.final s1
s0 -> idle -> run "start" -> done "finish" -> s1
run ..> idle "pause"
