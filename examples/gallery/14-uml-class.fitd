# UML class diagram (Reggio et al.: most used UML diagram; Nickerson: most common UML type).
include "uml"
layout layered
page 4:3
font 9pt..28pt
uml.iface shape Shape "area(): float"
uml.class
  circle Circle "r: float"
  rect Rect "w: float; h: float"
  canvas Canvas "draw()"
uml.is
  circle shape
  rect shape
uml.has canvas shape "0..*"
uml.key()
