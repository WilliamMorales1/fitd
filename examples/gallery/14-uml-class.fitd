// UML class diagram (Reggio et al.: most used UML diagram; Nickerson: most common UML type).
include "uml"
layout layered
page 4:3

uml.iface(shape, Shape, ["area(): float"])
uml.class(circle, Circle, ["r: float"])
uml.class(rect, Rect, ["w: float", "h: float"])
uml.class(canvas, Canvas, ["draw()"])
uml.is(circle, shape)
uml.is(rect, shape)
uml.has(canvas, shape, "0..*")
uml.key()
