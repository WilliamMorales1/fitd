# Templates for service diagrams; `use service(...)` draws one service with its store.
style svc color=#1E88E5
style db color=#6D4C41 shape=circle
style edge color=#00897B

def service(id, label, store)
  node ${id} "${label}" .svc
  node ${id}_db "${store}" .db
  ${id} -> ${id}_db
  require ${id} above ${id}_db
end
