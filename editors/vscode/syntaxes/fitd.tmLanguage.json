{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fitd",
  "scopeName": "source.fitd",
  "fileTypes": ["fitd"],
  "patterns": [
    { "include": "#body" },
    { "include": "#macro" },
    { "include": "#interpolation" },
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#statement" },
    { "include": "#string" },
    { "include": "#color" },
    { "include": "#attribute" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#relation" }
  ],
  "repository": {
    "body": {
      "comment": "A `|` or `~` first on a line makes the rest of it a body or figure row, verbatim.",
      "match": "^\\s*([|~])(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.body.fitd" },
        "2": { "name": "string.unquoted.body.fitd", "patterns": [{ "include": "#interpolation" }] }
      }
    },
    "macro": {
      "comment": "Macro lines.",
      "patterns": [
        {
          "match": "^\\s*(def)\\s+([\\w]+)",
          "captures": {
            "1": { "name": "keyword.control.macro.fitd" },
            "2": { "name": "entity.name.function.template.fitd" }
          }
        },
        {
          "match": "^\\s*(for)\\s+([\\w\\s,]+?)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.macro.fitd" },
            "2": { "name": "variable.other.fitd" },
            "3": { "name": "keyword.control.macro.fitd" }
          }
        },
        {
          "match": "^\\s*(}\\s*)?(if|else)\\b",
          "name": "keyword.control.macro.fitd"
        }
      ]
    },
    "interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "name": "meta.interpolation.fitd",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.fitd" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.fitd" } },
      "patterns": [
        { "include": "#string" },
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.fitd" },
        { "match": "\\b[A-Za-z_]\\w*\\b", "name": "variable.other.fitd" }
      ]
    },
    "comment": {
      "comment": "`//` starts a comment; `#` right after `=` is a color.",
      "match": "//.*$",
      "name": "comment.line.number-sign.fitd"
    },
    "declaration": {
      "patterns": [
        {
          "comment": "A node line: an id followed by a title or attribute.",
          "match": "^\\s*(?!(?:title|root|layout|page|font|theme|style|key|group|require|prefer|include|with|for|if|else|def)\\b)([A-Za-z_][\\w-]*)(?=\\s+(?:\"|[\\w-]+=))",
          "captures": { "1": { "name": "entity.name.function.node.fitd" } }
        },
        {
          "comment": "`name(` or `mod.name(` calls a template.",
          "match": "^\\s*([A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)?)(?=\\()",
          "captures": { "1": { "name": "entity.name.function.template.fitd" } }
        },
        {
          "comment": "A lone name declares or reopens a node.",
          "match": "^\\s*(?!(?:title|root|layout|page|font|theme|style|key|group|require|prefer|include|with|for|if|else|def)\\b)([A-Za-z_][\\w-]*)\\s*(?=\\{|//|$)",
          "captures": { "1": { "name": "entity.name.function.node.fitd" } }
        },
        {
          "match": "^\\s*(style|with)\\s+([\\w.-]+)",
          "captures": {
            "1": { "name": "keyword.control.fitd" },
            "2": { "name": "entity.name.type.style.fitd" }
          }
        }
      ]
    },
    "statement": {
      "match": "^\\s*(title|root|layout|page|font|theme|key|group|require|prefer|include)\\b",
      "name": "keyword.control.fitd"
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.fitd",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.fitd" },
        { "include": "#interpolation" },
        { "match": "[\\^_]\\{", "name": "keyword.operator.script.fitd" }
      ]
    },
    "color": {
      "match": "(?<==)#[0-9A-Fa-f]+",
      "name": "constant.other.color.fitd"
    },
    "attribute": {
      "match": "\\b([\\w-]+)(=)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.fitd" },
        "2": { "name": "keyword.operator.assignment.fitd" }
      }
    },
    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?(?:x\\d+(?:\\.\\d+)?)?(?:pt|mm|cm|in|em)?\\b",
      "name": "constant.numeric.fitd"
    },
    "operator": {
      "match": "->|--|\\.\\.>|\\.\\.",
      "name": "keyword.operator.edge.fitd"
    },
    "relation": {
      "match": "\\b(left-of|right-of|above|below|near|align|at|radial|layered)\\b",
      "name": "keyword.other.relation.fitd"
    }
  }
}
