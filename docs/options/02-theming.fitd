title "Theming"
page 320x180mm margin=1cm
root theme

node theme "theme light|dark|mono key=#hex"
| every option has a default: leave them all out and the
| output is dark in DejaVu Serif
| light suits bright rooms, mono prints in grayscale
| colors are #RGB or #RRGGBB

node preset "Theme colors" color=#57606A
| each box below is filled with its dark default
theme -> preset

def swatch(key, hex, what)
  node ${key} "${key}=${hex}" fill=${hex} color=#57606A
  | ${what}
  preset -> ${key}
end
use swatch("background", "#0D1117", "page, box interiors, label backing")
use swatch("text", "#E6EDF3", "text in boxes; root outline")
use swatch("edge", "#8B949E", "layered arrows")
use swatch("link", "#6E7681", "dashed cross links")
use swatch("label", "#8B949E", "edge label text")
use swatch("root", "#21262D", "radial root circle fill")

node palette "palette=\"#0969DA #CF222E ...\"" color=#0969DA
| branch colors, cycled; 8 by default
| quoted, space or comma separated
theme -> palette

node per "On nodes, edges, groups" color=#1A7F37
theme -> per
node color "color=#hex" color=#1A7F37
| node or style: border, tint, circle fill, branch lines
| edge: stroke and arrowhead
| group: frame border, tint, and title (default theme edge)
node fill "fill=#hex" fill=#B6E3B6 color=#1A7F37
| solid fill instead of the tint of color
node txt "text=#hex" text=#1A7F37 color=#1A7F37
| default theme text, or black or white by contrast on a fill
per -> color, fill, txt

node family "font ... family=\"Inter\"" color=#8250DF
| measured and drawn in that family; must be installed
| (fc-list : family); fallbacks cover missing glyphs
| changes measured widths, so font size and layout may change
| without fontconfig the family is ignored with a note
theme -> family
