title "Theming"
page 320x180mm margin=1cm
root theme

node theme "theme light|dark|mono key=#hex"
| every option has a default: leave them all out and the
| output is light in DejaVu Serif
| dark suits screens, mono prints in grayscale
| colors are #RGB or #RRGGBB

node preset "Theme colors" color=#455A64
| each box below is filled with its light default
theme -> preset

def swatch(key, hex, what)
  node ${key} "${key}=${hex}" fill=${hex} color=#455A64
  | ${what}
  preset -> ${key}
end
use swatch("background", "#FFFFFF", "page, box interiors, label backing")
use swatch("text", "#111111", "text in boxes; root outline")
use swatch("edge", "#555555", "layered arrows")
use swatch("link", "#777777", "dashed cross links")
use swatch("label", "#555555", "edge label text")
use swatch("root", "#EEEEEE", "radial root circle fill")

node palette "palette=\"#1565C0 #C62828 ...\"" color=#1565C0
| branch colors, cycled; 8 by default
| quoted, space or comma separated
theme -> palette

node per "On nodes, edges, groups" color=#2E7D32
theme -> per
node color "color=#hex" color=#2E7D32
| node or style: border, tint, circle fill, branch lines
| edge: stroke and arrowhead
| group: frame border, tint, and title (default theme edge)
node fill "fill=#hex" fill=#C8E6C9 color=#2E7D32
| solid fill instead of the tint of color
node txt "text=#hex" text=#2E7D32 color=#2E7D32
| default theme text, or black or white by contrast on a fill
per -> color, fill, txt

node family "font ... family=\"Inter\"" color=#6A1B9A
| measured and drawn in that family; must be installed
| (fc-list : family); fallbacks cover missing glyphs
| changes measured widths, so font size and layout may change
| without fontconfig the family is ignored with a note
theme -> family
