title "fitd FILE [flags]"
page 320x180mm margin=1cm
root cli

style out color=#0969DA
style geo color=#1A7F37
style search color=#8250DF
style flow color=#BC4C00

node cli "fitd FILE"
| flags override settings in the file
| FITD_DEBUG=1 traces each probe

node out "Output" .out
node geo "Page and font" .geo
node search "Search" .search
node flow "Workflow" .flow
cli -> out, geo, search, flow

node o "-o FILE.svg|.png|.pdf" .out
| format by extension; SVG is page-sized (default FILE.svg)
| PNG is cropped to the drawing plus --margin padding
| PDF is page-sized, fonts embedded, text selectable
node multi "fitd a.fitd b.fitd ... -o FILE.pdf" .out
| one PDF, one page per input, in the order given
| each page is laid out on its own; if any fails, nothing is written
| --tikz, --stable, --watch, and stdin take one input
node stdin "- as input" .out
| reads the source from stdin; then needs -o
node scale "--scale PX" .out
| PNG pixels per point, default 2
node tikz "--tikz FILE.tex" .out
| also write standalone LaTeX with absolute positions
node short "--short" .out
| one line per diagnostic, for agents and editors
node force "--force" .out
| write output despite checker errors
out -> o, multi, stdin, scale, tikz, short, force

node page "--page a0..a4|WxH[pt|mm]" .geo
node orient "--portrait / --landscape" .geo
| fix the orientation; otherwise a named paper may be
| turned when that clears warnings
node margin "--margin PT" .geo
node minf "--min-font PT" .geo
| hard floor; also raises the legibility floor of the
| trade-off, default 16pt per meter of page diagonal
node maxf "--max-font PT" .geo
node wrap "--wrap EM" .geo
node fam "--font-family NAME" .geo
node theme "--theme light|dark|mono" .geo
| swaps the preset, keeps the file's overrides
node bands "--bands N" .geo
| most bands a long flowchart wraps into; 1 never wraps
geo -> page, orient, margin, minf, maxf, wrap, fam, theme, bands

node budget "--budget CHECKS" .search
| solver checks per probe, default 20M
node xbudget "--expand-budget STEPS" .search
| macro expansion steps, default 100000
node draft "--draft" .search
| coarser font search, one font, short polish:
| 2 to 6 times faster for editing
search -> budget, xbudget, draft

node stable "--stable LOCK" .flow
| keep the layout steady across edits; see page 3
node watch "--watch" .flow
| rebuild on change; see page 4
node sub "Subcommands" .flow
| fitd guide: the language on one page
| fitd explain CODE: the long form of a diagnostic
| fitd split FILE: one page per branch; see page 5
| fitd import FILE.dot|.mmd|.d2: translate from Graphviz,
| Mermaid, or D2, listing what has no equivalent
| fitd lsp: language server for editors
flow -> stable, watch, sub
