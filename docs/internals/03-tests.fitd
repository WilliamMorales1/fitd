title "Tests and performance"
page 320x180mm margin=1cm
root t

style unit color=#1565C0
style e2e color=#2E7D32
style perf color=#EF6C00

node t "cargo test --release"

node unit "Unit tests" .unit
| macro expansion: loops, templates, recursion, the budget, line mapping
| lexer, parser, semantic checks, geometry
| solver: queens, pigeonhole, branch and bound, spatial index equivalence
| layering, QuickXplain
| every code has a fitd explain page and a node in diagnostics.fitd
node e2e "End to end" .e2e
| every example: zero errors, a warning baseline, a CPU-time budget,
| and two concurrent builds that must match byte for byte
| every doc diagram: zero errors and zero warnings, shown in the README
| unsat cores, static contradictions, parse errors,
| macro diagnostics across includes
node fix "tests/fixtures/" .e2e
| inputs that fail or strain the solver on purpose
| collatz.fitd: a template with no fixed bound
node fuzz "Fuzzer" .e2e
| mutated sources, macro lines among them, fed to the
| front end for 2 seconds
| FITD_FUZZ_SECS=1800 cargo test --release fuzz runs longer
t -> unit, e2e, fuzz
e2e -> fix

node bench "bench/bench.py" .perf
| builds every example and fixture, median of three runs
| ThinkPad X280: i7-8650U, 4 cores, 8 threads, 16 GB, Linux 7.3, rustc 1.99.1
node ci "CI gate" .perf
| --check bench/baseline.tsv fails when any file needs over
| 25% more solver checks; checks are deterministic, so this
| holds on any machine
| --time also gates CPU time, only meaningful on the machine
| that wrote the baseline (--write); one run can vary by a
| third under thermal throttling, so keep three runs
t -> bench -> ci

def row(id, file, wall, cpu, checks, font)
  node ${id} "${file}" .perf
  | wall ${wall} s, CPU ${cpu} s
  | ${checks} checks, font ${font}
  bench -> ${id}
end
use row("b1", "fixtures/cell_biology", "0.59", "0.58", "16,055,958", "6.5pt")
use row("b2", "compiler", "0.81", "2.37", "3,827,207", "9.8pt")
use row("b3", "fixtures/earth_science", "2.93", "7.61", "91,907,928", "10.1pt")
use row("b4", "fixtures/french_history", "0.92", "0.91", "4,761,129", "8.2pt")
use row("b5", "group_theory", "3.45", "5.97", "74,283,233", "7.7pt")
use row("b6", "fixtures/complex_constraints", "0.06", "0.15", "387,841", "30.1pt")
use row("b7", "fixtures/missing_glyph", "0.06", "0.16", "0", "48.0pt")
use row("b8", "fixtures/stress_test", "0.00", "0.00", "0", "none: fails by design")
