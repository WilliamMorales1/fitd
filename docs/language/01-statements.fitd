title "Statements: one per line"
page a4 portrait margin=1cm
root file

style content color=#8D6E63
style setting color=#2E7D32
style rule color=#1565C0

node file "A .fitd file"
| analyzed in two passes: declarations, then references
| so names may be used before they are declared

node content "Content" .content
node settings "Settings" .setting
node rules "Constraints" .rule
file -> content, settings, rules

node nodestmt "node ID \"Title\" .style key=value" .content
| title defaults to ID
| color= accent: border, tint, branch
| fill= solid fill instead of the tint
| text= text color; black or white by contrast on a fill
| shape=circle or shape=box
node body "| body line" .content
| detail text under the node above, any number of lines
node edges "a -> b, c \"label\" .style color=#hex" .content
| -> hierarchy or flow, ..> dashed cross link
| chain hops: a -> b -> c, or a -> b, c -- d; each hop makes one edge per source
| a hop's targets all feed the next hop; a label belongs to its hop
| .style and key=value at the end apply to every edge of the chain
| -- and .. draw no arrowhead
| an undirected edge still orders a flow, from the node written first
| a .style on an edge gives only its color; width and heads follow the layout
node grp "group \"Title\" a, b, c color=#hex" .content
| framed together; see page 4
node inc "include \"part.fitd\"" .content
| splices the file in, line for line, path relative to the includer
| a cycle or unreadable file: E0011; including twice: E0003
| styles from an included file are never reported unused
content -> nodestmt, body, edges, grp, inc

node titlestmt "title \"Text\"" .setting
node rootstmt "root ID" .setting
| the radial center
node layout "layout radial root=ID" .setting
| default; root defaults to the graph center (minimum eccentricity)
node layered "layout layered dir=down|right bands=N" .setting
| flowchart; directed cycles broken, back edges drawn as links
| a flow too long for a readable font wraps into bands; bands=1 never wraps
node page "page a0..a4|WxHmm portrait|landscape margin=LEN" .setting
| default a1; absolute lengths only
| no flag: when a layout has warnings, the turned page is tried too
node font "font LO..HI wrap=EM family=\"NAME\"" .setting
| the solver maximizes the body font in the range; one size fixes it
| default DejaVu Serif, built in; family needs fc-match
node theme "theme light|dark|mono key=#hex" .setting
| see options.pdf, page 2
node style "style NAME key=value" .setting
| node attributes win over styles, applied in order
settings -> titlestmt, rootstmt, layout, layered, page, font, theme, style

node req "require REL" .rule
| hard: the layout must satisfy it, or the build fails
node pref "prefer REL weight=N" .rule
| soft: minimizes the total weight unmet, after the font is fixed
| each unmet one is W0205
rules -> req, pref
