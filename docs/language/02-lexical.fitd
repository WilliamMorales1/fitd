title "Lines, names, values"
page a4 portrait margin=1cm
root lex

node lex "Lexing"
| newlines are tokens: one statement per line
| a line that fails to parse is reported and skipped,
| so one typo never hides the errors after it

node comment "# comment"
| runs to the end of the line
| except right after =, where # starts a color: color=#1565C0
node names "Names"
| letters, digits, _, and inner hyphens: left-of, top-left
| a hyphen never swallows an arrow: a->b is three tokens
node strings "\"Strings\""
| titles, labels, paths, family names
node numbers "NUMBER"
| a digit run with an attached unit or size suffix
| 12pt, 2em, 594x420mm; analysis gives it a type
node lengths "Lengths"
| need a unit: pt, mm, cm, in, em
| an em is the body font, known only once the solver picks it,
| so gap=2em scales with the font
node colors "Colors"
| #RGB or #RRGGBB
node override "Flags win"
| command-line flags override settings written in the file

lex -> comment, names, strings, numbers, colors, override
numbers -> lengths
comment ..> colors "# after ="
