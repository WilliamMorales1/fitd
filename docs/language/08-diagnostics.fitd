title "Diagnostic codes"
page 340x191mm margin=1cm
root diag

style front color=#0969DA
style solve color=#CF222E
style warn color=#BC4C00

diag "Diagnostics"
| rustc style, at the source lines that caused them
| fitd explain CODE prints the long form
| --short prints one line each

front
  front "E00xx: front end"
solve
  lay "E01xx: layout"
warn
  warn "W02xx: warnings"
  | never block output
diag -> front, lay, warn

def code(parent, c, text)
  node ${c} "${c}"
  | ${text}
  ${parent} -> ${c}
end

code front E0001 "unknown node, with a did-you-mean by edit distance"
code front E0002 "syntax error"
code front E0003 "node or style declared twice; points at both"
code front E0004 "unknown style"
code front E0005 "attribute not valid on this statement"
code front E0006 "wrong value type or unit"
code front E0007 "constraint names a node twice, or align with one node"
code front E0008 "contradictory hard orderings, found statically"
code front E0009 "unknown layout, relation, side, place, shape, or flag"
code front E0010 "two groups share some nodes without one holding the other"
code front E0011 "include cycle or unreadable file"
code front E0012 "macro error: unknown variable or template, argument count, type, division by zero, nesting too deep"
code front E0013 "macro expansion ran past --expand-budget steps"
code front E0014 "image row names a missing file or one not PNG or JPEG"
code front E0015 "style named after a keyword"

code lay E0101 "checker: overlap"
code lay E0102 "checker: edge through node"
code lay E0103 "checker: crossing"
code lay E0104 "checker: off page"
code lay E0105 "checker: text overflow"
code lay E0106 "checker: font too small"
code lay E0107 "checker: child nearer the center"
code lay E0108 "layout breaks a require or group; a solver bug"
code lay E0109 "edge label covered, overlapping, or clipped; a solver bug"
code lay E0110 "minimal set of requires that cannot hold together"

code warn W0201 "link through a node"
code warn W0202 "missing glyph"
code warn W0203 "unused style"
code warn W0204 "repeated setting"
code warn W0205 "unmet preference"
code warn W0206 "layered crossing"
code warn W0207 "links crossing or running together"
code warn W0208 "place=aside ignored"
