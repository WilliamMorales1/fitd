// Trees: syntax trees, decision trees, and org charts. Pair with `layout layered`.
style tree.cat [color=#444444, shape=none]
style tree.word [color=#0072B2, text=#0072B2, shape=none]
style tree.q [color=#E69F00, shape=box]
style tree.leaf [color=#009E73, shape=box]
style tree.unit [color=#0072B2, shape=box]

// tree.cat(id, label): an inner syntax-tree node such as S, NP, or VP.
def cat(id, label) {
  with tree.cat {
    ${id} "${label}"
  }
}

// tree.word(id, word): a leaf word of a syntax tree.
def word(id, word) {
  with tree.word {
    ${id} "${word}"
  }
}

// tree.q(id, question): a decision-tree test; label its edges with the answers.
def q(id, question) {
  with tree.q {
    ${id} "${question}"
  }
}

// tree.leaf(id, outcome): a decision-tree outcome.
def leaf(id, outcome) {
  with tree.leaf {
    ${id} "${outcome}"
  }
}

// tree.unit(id, name, role): an org-chart box naming a person or team and its role.
def unit(id, name, role) {
  with tree.unit {
    ${id} "${name}" {
      | ${role}
    }
  }
}

// tree.kids(parent, kids): edges from parent to each kid, in order.
def kids(parent, kids) {
  for k in kids {
    ${parent} -> ${k}
  }
}
