# UML class and state diagrams. Relations use UML heads; uml.key names them.
# Member and action lists split on `;`: "id: int; name: str; save()".
style uml_class color=#0072B2 shape=box
style uml_iface color=#56B4E9 shape=box
style uml_state color=#009E73 shape=box
style uml_mark color=#222222 fill=#222222 text=#FFFFFF shape=circle
style uml_is head=triangle
style uml_has tail=diamond
style uml_uses line=dashed

# uml.class id name members: a class box listing its members.
def class(id, name, members)
uml_class
  node ${id} "${name}"
lines ${members}
end

# uml.iface id name members: an interface, titled with its stereotype.
def iface(id, name, members)
uml_iface
  node ${id} "«interface» ${name}"
lines ${members}
end

# uml.state id name actions: a state listing its entry, do, and exit actions.
def state(id, name, actions)
uml_state
  node ${id} "${name}"
lines ${actions}
end

# uml.start id: the initial pseudostate.
def start(id)
uml_mark
  node ${id} "start"
end

# uml.final id: the final state.
def final(id)
uml_mark
  node ${id} "end"
end

# uml.is a b: a inherits from or implements b.
def is(a, b)
uml_is
  ${a} -> ${b}
end

# uml.has a b mult: a is composed of b, with b's multiplicity such as "1..*".
def has(a, b, mult)
uml_has
  ${a} -- ${b} "${mult}"
end

# uml.uses a b: a depends on b.
def uses(a, b)
uml_uses
  ${a} ..> ${b}
end

# uml.key: a legend for the three relation heads.
def key()
key "inherits" line=solid head=triangle
key "has" line=solid head=diamond
key "depends on" line=dashed head=arrow
end

def lines(items)
for i in 1..count(items, ";")
| ${part(items, ";", i)}
end
end
