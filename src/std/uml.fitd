# UML class and state diagrams. Relations use UML heads; uml_key() names them.
# Member and action lists split on `;`: "id: int; name: str; save()".
style uml_class color=#0072B2 shape=box
style uml_iface color=#56B4E9 shape=box
style uml_state color=#009E73 shape=box
style uml_mark color=#222222 fill=#222222 text=#FFFFFF shape=circle
style uml_is head=triangle
style uml_has tail=diamond
style uml_uses line=dashed

# uml_class(id, name, members): a class box listing its members.
def uml_class(id, name, members)
node ${id} "${name}" .uml_class
use uml_lines(members)
end

# uml_iface(id, name, members): an interface, titled with its stereotype.
def uml_iface(id, name, members)
node ${id} "«interface» ${name}" .uml_iface
use uml_lines(members)
end

# uml_state(id, name, actions): a state listing its entry, do, and exit actions.
def uml_state(id, name, actions)
node ${id} "${name}" .uml_state
use uml_lines(actions)
end

# uml_start(id): the initial pseudostate.
def uml_start(id)
node ${id} "start" .uml_mark
end

# uml_final(id): the final state.
def uml_final(id)
node ${id} "end" .uml_mark
end

# uml_is(a, b): a inherits from or implements b.
def uml_is(a, b)
${a} -> ${b} .uml_is
end

# uml_has(a, b, mult): a is composed of b, with b's multiplicity such as "1..*".
def uml_has(a, b, mult)
${a} -- ${b} "${mult}" .uml_has
end

# uml_uses(a, b): a depends on b.
def uml_uses(a, b)
${a} ..> ${b} .uml_uses
end

# uml_key(): a legend for the three relation heads.
def uml_key()
key "inherits" line=solid head=triangle
key "has" line=solid head=diamond
key "depends on" line=dashed head=arrow
end

def uml_lines(items)
for i in 1..count(items, ";")
| ${part(items, ";", i)}
end
end
