# System architecture and data-flow diagrams: clients, services, stores, queues, outside systems.
style arch_client color=#56B4E9 shape=box
style arch_service color=#0072B2 shape=box
style arch_store color=#009E73 shape=box
style arch_queue color=#E69F00 shape=box
style arch_ext color=#888888 shape=box
style arch_zone color=#888888

# arch.client id name: a user-facing client.
def client(id, name)
arch_client
  node ${id} "${name}"
end

# arch.service id name: a service or process.
def service(id, name)
arch_service
  node ${id} "${name}"
end

# arch.store id name: a database, cache, or file store.
def store(id, name)
arch_store
  node ${id} "${name}"
end

# arch.queue id name: a queue, topic, or stream.
def queue(id, name)
arch_queue
  node ${id} "${name}"
end

# arch.ext id name: a system outside the boundary.
def ext(id, name)
arch_ext
  node ${id} "${name}"
end

# arch.layers id title names: a layer stack, top layer first, names split on `;`.
def layers(id, title, names)
arch_service
  node ${id} "${title}"
for i in 1..count(names, ";")
~ #"${part(names, ";", i)}"*4
end
end

# arch.key: a legend for the element kinds.
def key()
key "client" color=#56B4E9
key "service" color=#0072B2
key "store" color=#009E73
key "queue" color=#E69F00
key "external" color=#888888
end
