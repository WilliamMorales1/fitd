// Grids drawn as figure rows: tables, heat maps, confusion matrices, Gantt bars, unit bar charts.
// Each template writes one `~` row into the node declared above it.
// Lists are written in brackets: [name, type, size], [90, 5, 5].
style grid [color=#0072B2, shape=box]

// grid.head(labels): a header row of outlined labels over the value columns, leaving the row-label column blank.
def head(labels) {
  ~ [_, for l in labels { "${l}" }]
}

// grid.row(cells): one table row of outlined labelled cells.
def row(cells) {
  ~ [for c in cells { "${c}" }]
}

// grid.title_row(cells): a table row of solid cells, for a header without a row-label column.
def title_row(cells) {
  ~ [for c in cells { %100"${c}" }]
}

// grid.heat(label, values): a heat-map row; values are percents 0..100 and each cell prints its value.
def heat(label, values) {
  ~ ["${label}", for v in values { %${v}"${v}" }]
}

// grid.shade(label, values): a heat-map row without numbers, for dense maps.
def shade(label, values) {
  ~ ["${label}", for v in values { %${v} }]
}

// grid.bar(label, n): a unit bar chart row of n solid cells after its label.
def bar(label, n) {
  task(${label}, 1, ${n})
}

// grid.task(label, start, len): a Gantt row; the bar covers columns start..start+len-1, counted from 1.
def task(label, start, len) {
  if len > 0 {
    ~ ["${label}", for g in 2..start { _ }, %100*${len}]
  } else {
    ~ ["${label}", for g in 2..start { _ }]
  }
}

// grid.scale(first, last): a Gantt header numbering the time columns first..last.
def scale(first, last) {
  ~ [_, for i in first..last { "${i}" }]
}

// grid.layers(names): a layer stack, one full-width solid row per name, top layer first.
def layers(names) {
  for n in names {
    ~ [%100"${n}"*4]
  }
}

// grid.quad(tl, tr, bl, br): a 2x2 matrix (SWOT, effort/impact) with the diagonal shaded darker.
def quad(tl, tr, bl, br) {
  ~ [%80"${tl}", %25"${tr}"]
  ~ [%25"${bl}", %80"${br}"]
}
