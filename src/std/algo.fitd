// Algorithm and pseudocode blocks. Leading spaces in a line indent it.
// Write keywords in `**`: ["**for** v **in** V **do**", "  d[v] = inf"].
style algo.block [color=#0072B2, shape=box, wrap=40em]

// algo.block(id, title, lines): a titled pseudocode block whose lines keep their indent.
def block(id, title, lines) {
  with algo.block {
    ${id} "${title}" {
      for l in lines {
        | ${l}
      }
    }
  }
}
