// Algorithm and pseudocode blocks: lines nest under algo.for, algo.while, and algo.if, with keywords in bold.
style algo.block [color=#0072B2, shape=box, wrap=40em]

// algo.block(id, title, lines=[]): a titled pseudocode block holding `|` lines and the steps in its braces.
def block(id, title, lines=[]) {
  with algo.block {
    ${id} "${title}" {
      for l in lines {
        | ${l}
      }
    }
  }
}

// algo.for(head): a `for HEAD do` line with the lines in its braces under it.
def for(head) {
  | **for** ${head} **do**
}

// algo.while(cond): a `while COND do` line with the lines in its braces under it.
def while(cond) {
  | **while** ${cond} **do**
}

// algo.if(cond): an `if COND then` line with the lines in its braces under it.
def if(cond) {
  | **if** ${cond} **then**
}

// algo.else(): an `else` line with the lines in its braces under it.
def else() {
  | **else**
}

// algo.return(value): a `return VALUE` line.
def return(value) {
  | **return** ${value}
}
