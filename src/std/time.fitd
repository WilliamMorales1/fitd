// Timelines: dated events and milestones in order. Pair with `layout layered dir=right`.
style time.event [color=#0072B2, shape=box]
style time.mile [color=#D55E00, shape=box]
style time.era [color=#56B4E9]

// time.event id date text: an event titled with its date.
def event(id, date, text) {
  with time.event {
    node ${id} "${date}" {
      | ${text}
    }
  }
}

// time.mile id date text: a milestone, drawn in the accent colour.
def mile(id, date, text) {
  with time.mile {
    node ${id} "${date}" {
      | ${text}
    }
  }
}

// time.chain ids: joins the `;`-separated events in order.
def chain(ids) {
  for i in 2..count(ids, ";") {
    ${part(ids, ";", i - 1)} -> ${part(ids, ";", i)}
  }
}
