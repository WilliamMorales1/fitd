# Timelines: dated events and milestones in order. Pair with `layout layered dir=right`.
style time_event color=#0072B2 shape=box
style time_mile color=#D55E00 shape=box
style time_era color=#56B4E9

# time_event(id, date, text): an event titled with its date.
def time_event(id, date, text)
node ${id} "${date}" .time_event
| ${text}
end

# time_mile(id, date, text): a milestone, drawn in the accent colour.
def time_mile(id, date, text)
node ${id} "${date}" .time_mile
| ${text}
end

# time_chain(ids): joins the `;`-separated events in order.
def time_chain(ids)
for i in 2..count(ids, ";")
${part(ids, ";", i - 1)} -> ${part(ids, ";", i)}
end
end
