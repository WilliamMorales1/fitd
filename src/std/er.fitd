# Entity-relationship diagrams: entities list attributes, links carry cardinality.
# Attribute lists split on `;`: "PK id; name; FK dept".
style er_entity color=#0072B2 shape=box
style er_weak color=#56B4E9 shape=box
style er_link color=#444444

# er_entity(id, name, attrs): an entity with its attributes, keys first.
def er_entity(id, name, attrs)
node ${id} "${name}" .er_entity
use er_lines(attrs)
end

# er_weak(id, name, attrs): a weak entity, identified through its owner.
def er_weak(id, name, attrs)
node ${id} "${name}" .er_weak
use er_lines(attrs)
end

# er_rel(a, b, card): a relationship such as "1:N" or "M:N".
def er_rel(a, b, card)
${a} -- ${b} "${card}" .er_link
end

def er_lines(items)
for i in 1..count(items, ";")
| ${part(items, ";", i)}
end
end
